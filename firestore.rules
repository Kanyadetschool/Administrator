rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Admin via authorized_users (by email). Requires a VERIFIED email so nobody
    // can sign up with an admin's address and inherit their role.
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email));
      return request.auth.token.email_verified == true && userDoc.data.role == 'admin';
    }

    function isAdminByUID() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role == 'admin';
    }

    function isAdvancedAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.Advancedadmin == true;
    }

    function isTeacher() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role == 'Teacher';
    }

    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role;
    }

    function isDocumentOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAnyAdmin() {
      return isAdminByUID() || isAdmin() || isAdvancedAdmin();
    }

    function isAssignedClaimTeacher(reportId) {
      return request.auth != null &&
        isTeacher() &&
        exists(/databases/$(database)/documents/cardReports/$(reportId)) &&
        get(/databases/$(database)/documents/cardReports/$(reportId)).data.assignment.uid == request.auth.uid;
    }

    function isValidClaimNotification() {
      return request.auth != null &&
        isAdvancedAdmin() &&
        request.resource.data.type == 'report_card_claim' &&
        request.resource.data.keys().hasOnly(['type', 'recipientId', 'recipientEmail', 'title', 'body', 'reportId', 'cardCode', 'dueDate', 'read', 'createdAt', 'createdBy']) &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientEmail is string &&
        request.resource.data.recipientEmail.size() <= 254 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 500 &&
        request.resource.data.reportId is string &&
        request.resource.data.cardCode is string &&
        request.resource.data.cardCode.size() <= 32 &&
        request.resource.data.createdBy is string &&
        request.resource.data.createdBy.size() <= 100 &&
        request.resource.data.dueDate is string &&
        request.resource.data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        request.resource.data.read == false &&
        request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/cardReports/$(request.resource.data.reportId)) &&
        getAfter(/databases/$(database)/documents/cardReports/$(request.resource.data.reportId)).data.assignment.uid == request.resource.data.recipientId;
    }

    // Fields only an Advanced Admin may set or change on a users/{userId} doc.
    function touchesAdvancedOnlyFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['Advancedadmin', 'passkeyRequired', 'passkeyRequiredUpdatedAt', 'passkeyRequiredUpdatedBy',
                 'passkeyOffer', 'passkeyExempt', 'passkeyExemptUpdatedAt', 'passkeyExemptUpdatedBy',
                 'canImportData', 'canImportDataUpdatedAt', 'canImportDataUpdatedBy', 'tempImportUntil']);
    }

    // Fields a person may never change on their OWN doc (admin tiers only).
    function touchesSelfLockedFields() {
      return touchesAdvancedOnlyFields()
        || request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            && string(request.resource.data.get('role', '')).lower() == 'admin');
    }

    // A self-created users doc may not claim any elevated status.
    function noElevatedClaims(d) {
      return d.get('Advancedadmin', false) == false
        && d.get('passkeyRequired', false) == false
        && d.get('passkeyOffer', false) == false
        && d.get('disabled', false) == false
        && !('passkeyExempt' in d)
        && string(d.get('role', '')).lower() != 'admin';
    }

    // ============================================
    // AUTHORIZED USERS
    // ============================================
    // get stays public (email check before login); listing the whole
    // collection is admin-only so emails can't be harvested.
    match /authorized_users/{email} {
      allow get: if true;
      allow list: if request.auth != null && isAnyAdmin();
      allow write: if request.auth != null && isAdmin();
    }

    match /config/loginAccessControl {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.Advancedadmin == true;
    }

    match /config/maintenanceMode {
      allow read: if request.auth != null;   // every signed-in user needs to see it
      allow write: if request.auth != null && isAdvancedAdmin();
    }

    match /config/termAutomation {
      allow read, write: if request.auth != null && isAdvancedAdmin();
    }

    // Control Center: device check-ins. Each device writes only its own session;
    // Advanced Admins can read all sessions and flag one as signed out (revoked).
    match /sessions/{sid} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdvancedAdmin());
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.get('revoked', false) == false;
      allow update: if request.auth != null &&
        ((resource.data.uid == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['revoked', 'uid']))
         || isAdvancedAdmin());
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdvancedAdmin());
    }

    match /nameVerificationRegisters/{regId} {
      allow read: if request.auth != null &&
        (isAnyAdmin() ||
         !('assignedTeacherEmail' in resource.data) ||
         resource.data.assignedTeacherEmail == request.auth.token.email.lower());
      allow write: if request.auth != null && isAnyAdmin();
      match /students/{studentId} {
        allow read: if request.auth != null &&
          (isAnyAdmin() ||
           !('assignedTeacherEmail' in get(/databases/$(database)/documents/nameVerificationRegisters/$(regId)).data) ||
           get(/databases/$(database)/documents/nameVerificationRegisters/$(regId)).data.assignedTeacherEmail == request.auth.token.email.lower());
        allow update: if request.auth != null &&
          (isAnyAdmin() ||
           !('assignedTeacherEmail' in get(/databases/$(database)/documents/nameVerificationRegisters/$(regId)).data) ||
           get(/databases/$(database)/documents/nameVerificationRegisters/$(regId)).data.assignedTeacherEmail == request.auth.token.email.lower());
        allow create, delete: if request.auth != null && (isAnyAdmin() || isTeacher());
      }
    }

    // Public certificate verification (unguessable token as document ID).
    match /certificateVerifications/{token} {
      allow get: if true;
      allow list: if request.auth != null && isAnyAdmin();
      allow create, update, delete: if request.auth != null && isAnyAdmin();
    }

    // Full graduand lists: Advanced Admins only.
    match /graduation/{batchId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.Advancedadmin == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.Advancedadmin == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    match /graduationVerify/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.Advancedadmin == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    // Card verification records used by the public verification page.
    match /cardVerifications/{serial} {
      allow get: if true;
      allow list: if request.auth != null && isAdvancedAdmin();
      allow create: if request.auth != null && (isAnyAdmin() || isTeacher()) &&
                       request.resource.data.issuedByUid == request.auth.uid &&
                       request.resource.data.status == 'valid';
      allow update: if request.auth != null && (isAnyAdmin() || isTeacher()) &&
                       request.resource.data.issuedByUid == request.auth.uid &&
                       (request.resource.data.status == resource.data.status || isAdvancedAdmin());
      // Advanced Admin (head teacher) may withdraw or reinstate any card, e.g. from a report.
      allow update: if request.auth != null && isAdvancedAdmin();
      allow delete: if request.auth != null && isAdvancedAdmin();
    }

    // Forgery-attempt log written by verify.html (best effort). Public may only ADD a tiny, strictly
    // shaped entry; nobody can edit or delete; only Advanced Admins can read. No names, no IPs.
    match /verifyLog/{id} {
      allow create: if request.resource.data.keys().hasOnly(['serial', 'result', 'at', 'lang']) &&
                       request.resource.data.serial is string && request.resource.data.serial.size() == 8 &&
                       request.resource.data.result in ['ok', 'superseded', 'revoked', 'notfound'] &&
                       request.resource.data.lang in ['en', 'sw'] &&
                       request.resource.data.at == request.time;
      allow read: if request.auth != null && isAdvancedAdmin();
      allow update, delete: if false;
    }

    // Report-a-problem. Public can submit; admins manage all reports; only the assigned teacher
    // can read/update their own claim, and only its assignment result/status fields.
    match /cardReports/{ref} {
      allow create: if ref.matches('^REP-[0-9A-Z]{8}$') &&
                       request.resource.data.keys().hasOnly(['ref', 'serial', 'receipt', 'category', 'message', 'name', 'contact', 'lang', 'via', 'at']) &&
                       request.resource.data.ref == ref &&
                       request.resource.data.serial is string && request.resource.data.serial.size() in [0, 8] &&
                       request.resource.data.receipt is string && request.resource.data.receipt.size() <= 40 &&
                       request.resource.data.category in ['marks', 'photo', 'fake', 'notfound', 'details', 'lost', 'other'] &&
                       request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 1000 &&
                       request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
                       request.resource.data.contact is string && request.resource.data.contact.size() <= 80 &&
                       request.resource.data.lang in ['en', 'sw'] &&
                       request.resource.data.via in ['page', 'whatsapp'] &&
                       request.resource.data.at == request.time;
      allow get, list: if request.auth != null &&
                         (isAdvancedAdmin() ||
                          (isTeacher() && resource.data.assignment.uid == request.auth.uid));
      allow update: if request.auth != null && isAdvancedAdmin();
      allow update: if request.auth != null &&
                       isTeacher() &&
                       resource.data.assignment.uid == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignment', 'status']) &&
                       request.resource.data.assignment.keys().hasOnly(['uid', 'name', 'email', 'phone', 'dueDate', 'checkedBy', 'assignedAt', 'assignedBy', 'status', 'teacherFinding', 'updatedAt']) &&
                       request.resource.data.assignment.uid == request.auth.uid &&
                       request.resource.data.assignment.name == resource.data.assignment.name &&
                       request.resource.data.assignment.email == resource.data.assignment.email &&
                       request.resource.data.assignment.phone == resource.data.assignment.phone &&
                       request.resource.data.assignment.dueDate == resource.data.assignment.dueDate &&
                       request.resource.data.assignment.assignedAt == resource.data.assignment.assignedAt &&
                       request.resource.data.assignment.assignedBy == resource.data.assignment.assignedBy &&
                       request.resource.data.assignment.status in ['checking', 'checked'] &&
                       request.resource.data.assignment.checkedBy is string &&
                       request.resource.data.assignment.checkedBy.size() <= 60 &&
                       request.resource.data.assignment.teacherFinding is string &&
                       request.resource.data.assignment.teacherFinding.size() <= 500 &&
                       request.resource.data.assignment.updatedAt == request.time &&
                       request.resource.data.status in ['received', 'reviewing'];
      allow delete: if request.auth != null && isAdvancedAdmin();
    }

    // Public progress tracker for a report: whoever holds the (unguessable) reference can see its status + note.
    match /reportStatus/{ref} {
      allow get: if true;
      allow list: if request.auth != null && isAdvancedAdmin();
      allow create: if ref.matches('^REP-[0-9A-Z]{8}$') &&
                       request.resource.data.keys().hasOnly(['status', 'note', 'updatedAt']) &&
                       request.resource.data.status == 'received' && request.resource.data.note == '' &&
                       request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && isAdvancedAdmin() &&
                      request.resource.data.keys().hasOnly(['status', 'note', 'updatedAt', 'assignment']) &&
                      request.resource.data.keys().hasAll(['status', 'note', 'updatedAt']);
      allow update: if isAssignedClaimTeacher(ref) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'updatedAt']) &&
                       request.resource.data.status in ['received', 'reviewing'] &&
                       request.resource.data.note is string &&
                       request.resource.data.note.size() <= 500 &&
                       request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && isAdvancedAdmin();
    }

    // Who to WhatsApp for problems (set by the Advanced Admin in report-inbox.html). One public document.
    match /publicConfig/{docId} {
      allow get: if docId == 'reportContact';
      allow list: if false;
      allow write: if request.auth != null && isAdvancedAdmin() && docId == 'reportContact' &&
                      request.resource.data.keys().hasOnly(['whatsapp', 'name', 'updatedAt']) &&
                      request.resource.data.whatsapp.matches('^[0-9]{10,15}$');
    }

    // learner+term -> serial, so reprints reuse the same serial. Staff only.
    match /cardSerialIndex/{key} {
      allow read, write: if request.auth != null && (isAnyAdmin() || isTeacher());
    }

    // ============================================
    // LIBRARY
    // ============================================
    match /libraryBooks/{bookId} {
      allow read: if true;
      allow write: if request.auth != null && isAnyAdmin();
    }

    match /libraryTransactions/{txId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAnyAdmin();
    }

    match /libraryReservations/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.requesterUid == request.auth.uid || isAnyAdmin());
      allow create: if request.auth != null &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if request.auth != null && isAnyAdmin();
    }

    match /librarySubjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAnyAdmin();
    }

    // ============================================
    // PARENT PORTAL
    // ============================================
    // Only staff may post announcements.
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.createdByUid == request.auth.uid &&
                       (isAnyAdmin() || isTeacher());
      allow update, delete: if request.auth != null &&
                       (resource.data.createdByUid == request.auth.uid || isAnyAdmin());
    }

    match /parents/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid &&
                       request.resource.data.status == 'pending';

      // status may only flip to 'approved' if authorizedParents is approved
      // AND the parent's email is verified.
      allow update: if request.auth != null && (
        (request.auth.uid == uid &&
          (
            !('status' in request.resource.data.diff(resource.data).affectedKeys())
            ||
            (request.resource.data.status == 'approved' &&
             request.auth.token.email_verified == true &&
             get(/databases/$(database)/documents/authorizedParents/$(request.auth.token.email.lower())).data.status == 'approved')
          )
        )
        || isAdvancedAdmin()
      );

      allow delete: if isAdvancedAdmin();
    }

    match /authorizedParents/{email} {
      allow read: if request.auth != null &&
        (email == request.auth.token.email.lower() || isAdvancedAdmin());
      allow create: if request.auth != null && (
        (email == request.auth.token.email.lower() &&
         request.resource.data.email == email &&
         request.resource.data.status == 'pending')
        || isAdvancedAdmin()
      );
      allow update, delete: if isAdvancedAdmin();
    }

    match /settings/{docId} {
      allow read, write: if request.auth != null && isAdvancedAdmin();
    }

    match /auditLog/{docId} {
      allow read: if request.auth != null && isAdvancedAdmin();
      allow create: if request.auth != null && isAdvancedAdmin();
      allow update, delete: if false;
    }

    // ============================================
    // TEACHERS PORTAL
    // ============================================
    match /resources/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.createdByUid == request.auth.uid &&
                       (isAnyAdmin() || isTeacher());
      allow update, delete: if request.auth != null &&
                       (resource.data.createdByUid == request.auth.uid || isAnyAdmin());
    }

    match /leaveRequests/{docId} {
      allow read: if request.auth != null &&
                     (resource.data.uid == request.auth.uid || isAnyAdmin());
      allow create: if request.auth != null &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && isAnyAdmin();
      allow delete: if request.auth != null &&
                       (resource.data.uid == request.auth.uid || isAnyAdmin());
    }

    match /welfareContributions/{docId} {
      allow read: if request.auth != null &&
                     (resource.data.uid == request.auth.uid || isAnyAdmin());
      allow create: if request.auth != null &&
                       request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Login activity: anyone signed in may add an entry; only admins read; no edits.
    match /login_activity/{document=**} {
      allow read: if request.auth != null && isAnyAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /Students/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /Activities/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Teachers: signed-in only (was public).
    match /teachers/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /subjects/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Submissions: staff only may write.
    match /submissions/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAnyAdmin() || isTeacher());
    }

    match /teacherSubmissions/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAnyAdmin() || isTeacher());
    }

    match /books/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /issuance/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Messages: signed-in only (was open to the whole internet).
    match /messages/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /message_threads/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Audit log: append-only, admins read.
    match /auditLogs/{document=**} {
      allow read: if request.auth != null && isAnyAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /Results/{appId}/students/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /JuniorSchoolResultsDatabase/{appId}/students/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /DeletedResults/{appId}/artifacts/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /JuniorSchoolDeletedResults/{appId}/artifacts/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /Deletedstudents/{appId}/artifacts/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /artifacts/{appId}/students/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {

      allow get: if request.auth != null &&
                     (request.auth.uid == userId ||
                      isAdminByUID() ||
                      isAdmin() ||
                      isAdvancedAdmin());

      allow list: if request.auth != null &&
                     (isTeacher() || isAdvancedAdmin());

      // Self-registration may not claim admin, Advancedadmin, passkey flags
      // or a re-enabled state. Advanced Admins may create anything.
      allow create: if request.auth != null &&
                       (
                         (request.auth.uid == userId && noElevatedClaims(request.resource.data))
                         || isAdvancedAdmin()
                         || ((isAdminByUID() || isAdmin()) && noElevatedClaims(request.resource.data))
                       );

      // Own profile: cannot touch locked fields.
      // Admin / authorized_users admin: cannot touch Advanced-only fields.
      // Advanced Admin: anything.
      allow update: if request.auth != null &&
                       (
                         (request.auth.uid == userId && !touchesSelfLockedFields())
                         || ((isAdminByUID() || isAdmin()) && !touchesAdvancedOnlyFields())
                         || isAdvancedAdmin()
                       );

      allow delete: if request.auth != null &&
                       (isAdminByUID() || isAdmin() || isAdvancedAdmin());
    }

    // ============================================
    // REQUESTS
    // ============================================
    match /requests/{requestId} {
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid || isAdminByUID());
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdminByUID();
      allow delete: if request.auth != null &&
                       ((resource.data.userId == request.auth.uid && resource.data.status == 'pending') || isAdminByUID());
    }

    // ============================================
    // NOTIFICATIONS
    // ============================================
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
                     (resource.data.recipientEmail == request.auth.token.email ||
                      resource.data.recipientId == request.auth.uid ||
                      isAdminByUID());
      allow create: if isAdminByUID() || isValidClaimNotification();
      allow update: if request.auth != null &&
                       (resource.data.recipientEmail == request.auth.token.email ||
                        resource.data.recipientId == request.auth.uid);
      allow delete: if request.auth != null &&
                       (resource.data.recipientEmail == request.auth.token.email ||
                        resource.data.recipientId == request.auth.uid ||
                        isAdminByUID());
    }

    // ============================================
    // AUDIT LOGS
    // ============================================
    match /audit_logs/{logId} {
      allow read: if isAdminByUID();
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}